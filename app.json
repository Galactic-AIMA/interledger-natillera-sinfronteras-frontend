{
  "expo": {
    "name": "Natillera sin Fronteras",
    "slug": "natillera-sin-fronteras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "natillera",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.galacticaima.natillera"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1B4B",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundImage": "./assets/brand/android-icon-background.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.galacticaima.natillera"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1B4B",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
