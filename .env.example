# Copiar a .env (no se versiona). Valores públicos: nunca pongas aquí llaves privadas.
# URL base de API Gateway del back (sin / al final). Vacío = la app arranca en modo demo.
EXPO_PUBLIC_API_URL=
# Cognito: región y App Client ID (sin secreto, con USER_PASSWORD_AUTH habilitado).
EXPO_PUBLIC_COGNITO_REGION=us-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Token que espera el authorizer de API Gateway: access (por defecto) o id.
EXPO_PUBLIC_AUTH_TOKEN_TYPE=access
# 1 = forzar modo demo con datos de ejemplo.
EXPO_PUBLIC_USE_MOCKS=
