# Copiar a .env (no se versiona). Valores públicos: nunca pongas aquí llaves privadas.
# URL base del API del back (sin / al final). Vacío = el perfil sale del token y no hay pagos reales.
EXPO_PUBLIC_API_URL=
# Cognito: región y App Client ID (sin secreto, con USER_PASSWORD_AUTH habilitado).
EXPO_PUBLIC_COGNITO_REGION=us-east-2
EXPO_PUBLIC_COGNITO_CLIENT_ID=20b10a2tnnr69lqlp2sf62orv0
# Token que espera el autorizador: el API REST del back (autorizador Cognito) pide el IdToken → id.
EXPO_PUBLIC_AUTH_TOKEN_TYPE=id
# Ruta de "iniciar pago". Vacío = /payments (contrato). El back la desplegó primero como /start-payment.
EXPO_PUBLIC_PAYMENTS_START_PATH=
# Modo híbrido: funciones que ya van contra el back además de login, registro y perfil (separadas por coma),
# p. ej. startPayment. Con startPayment, los pagos P2P van al back y su finish/get también; con getMyNatillera
# además, la cuota. Ver src/api/hybridApi.ts. Lo que el back tiene desplegado en dev (2026-10-16 noche):
# getMyNatillera,createNatillera,getInvitation,joinNatillera,listAccounts,saveAccount,startPayment,finishPayment,getPayment,listPayments
EXPO_PUBLIC_REAL_METHODS=
# 1 = forzar modo demo con datos de ejemplo.
EXPO_PUBLIC_USE_MOCKS=
